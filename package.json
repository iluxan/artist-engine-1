{
  "name": "event-discovery-agent",
  "version": "1.0.0",
  "description": "Personal event discovery agent to track events from people you follow",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "eval": "promptfoo eval -c evals/promptfooconfig.yaml",
    "eval:view": "promptfoo view -y",
    "eval:watch": "promptfoo eval -c evals/promptfooconfig.yaml --watch",
    "postinstall": "node -e \"try{require('fs').symlinkSync('dist/drizzle','node_modules/promptfoo/drizzle','dir')}catch(e){}\""
  },
  "keywords": [
    "events",
    "discovery",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "openai": "^5.23.1"
  },
  "devDependencies": {
    "promptfoo": "^0.122.0"
  }
}
